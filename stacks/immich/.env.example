# Copia como .env junto a compose.yaml, con permisos 600 (lleva una contraseña).
# Valores de este equipo: id -u immich / id -g immich / getent group syncthing
UPLOAD_LOCATION=/srv/datos/immich
DB_DATA_LOCATION=/srv/immich/postgres
TZ=Europe/Madrid
IMMICH_VERSION=v3.4.1
# Aleatoria, solo letras y números: openssl rand -hex 24
DB_PASSWORD=<CONTRASEÑA_BD_IMMICH>
DB_USERNAME=postgres
DB_DATABASE_NAME=immich
IMMICH_UID=<UID_IMMICH>
IMMICH_GID=<GID_IMMICH>
SYNCTHING_GID=<GID_SYNCTHING>
